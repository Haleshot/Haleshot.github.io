---
import dayjs from "dayjs";
import { type Byline, bylineSource, outletHost, outletIcon } from "@/data/bylines";

export interface Props {
  bylines: Byline[];
}

// Writing published elsewhere. Own posts get full cards; these are a dated list
// on a dashed rule, each row marked on the rule with its outlet's own icon.
// The description and domain show in a preview on hover or focus.
const { bylines } = Astro.props;
const id = (b: Byline) => `byline-${b.href.replace(/[^a-z0-9]+/gi, "-").slice(-48)}`;

// The month is already the heading, so a row shows only its day, and only the
// first row of each day does
const dayOf = (b: Byline) => (b.pubDate ? dayjs(b.pubDate).format("D") : "");
const showDay = (i: number) => i === 0 || dayOf(bylines[i]) !== dayOf(bylines[i - 1]);
---

<li class="my-8" data-group>
  <ul class="ledger ml-3 border-l border-dashed border-accent/60 pl-5">
    {
      bylines.map((byline, i) => (
        <li class="byline-row relative" data-source={bylineSource(byline)}>
          {outletIcon(byline) && (
            <img src={outletIcon(byline)} alt="" width="18" height="18" loading="lazy" class="outlet-mark" />
          )}
          <a
            href={byline.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-describedby={id(byline)}
            class="group grid min-h-11 grid-cols-[1.5rem_minmax(0,1fr)] items-baseline gap-x-3 py-1.5 focus-visible:no-underline"
          >
            <span class="text-right text-sm tabular-nums opacity-70">
              {showDay(i) && dayOf(byline) && <time datetime={byline.pubDate}>{dayOf(byline)}</time>}
            </span>
            <span class="text-accent text-pretty decoration-dashed underline-offset-4 group-hover:underline">
              {byline.title}
              <span class="sr-only">, on {byline.outlet}</span>
            </span>
          </a>
          <div id={id(byline)} class="byline-preview" role="tooltip">
            <p class="flex items-center gap-1.5 text-xs opacity-70">
              {outletIcon(byline) && <img src={outletIcon(byline)} alt="" width="14" height="14" class="rounded-[3px]" />}
              {outletHost(byline)}
            </p>
            {byline.description && <p class="mt-1">{byline.description}</p>}
          </div>
        </li>
      ))
    }
  </ul>
</li>

<style>
  /* The outlet's mark sits centred on the dashed rule, ringed in the page colour
     so the dashes break around it */
  .outlet-mark {
    position: absolute;
    top: 0.6rem;
    left: calc(-1.25rem - 9.5px);
    width: 18px;
    height: 18px;
    border-radius: 4px;
    background: var(--background);
    box-shadow: 0 0 0 3px var(--background);
    transition: transform 150ms ease-out;
  }
  .byline-row:hover .outlet-mark,
  .byline-row:focus-within .outlet-mark {
    transform: scale(1.15);
  }

  /* Link preview: sits under the title column, fades and settles in */
  .byline-preview {
    position: absolute;
    z-index: 10;
    top: 100%;
    left: calc(1.5rem + 0.75rem);
    right: 0;
    max-width: 32rem;
    padding: 0.625rem 0.875rem;
    border: 1px solid var(--border);
    border-radius: 0.375rem;
    background: var(--background);
    color: var(--foreground);
    font-size: 0.875rem;
    box-shadow: 0 6px 20px -8px color-mix(in srgb, var(--foreground) 35%, transparent);
    opacity: 0;
    transform: translateY(-4px);
    pointer-events: none;
    transition:
      opacity 120ms ease-in,
      transform 120ms ease-in;
  }
  .byline-row:hover .byline-preview,
  .byline-row:focus-within .byline-preview {
    opacity: 1;
    transform: translateY(0);
    transition:
      opacity 180ms ease-out 250ms,
      transform 180ms ease-out 250ms;
  }
  .byline-row:focus-within .byline-preview {
    transition-delay: 0ms;
  }

  /* Touch screens have no hover, so the preview stays out of the way */
  @media (hover: none) {
    .byline-preview {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .outlet-mark,
    .byline-preview {
      transition: none !important;
      transform: none !important;
    }
  }
</style>
