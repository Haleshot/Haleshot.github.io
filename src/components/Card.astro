---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { getPath } from "@/utils/getPath";
import { getRelated } from "@/utils/getRelated";
import { calculateReadingTime } from "@/utils/readingTime";
import { slugifyStr } from "@/utils/slugify";
import Datetime from "./Datetime.astro";

export interface Props extends CollectionEntry<"blog"> {
  variant?: "h2" | "h3";
  showImage?: boolean;
  source?: string; // used by the posts page filter
}

const { variant = "h2", data, id, filePath, body, showImage = true, source } = Astro.props;

const { title, description, pubDatetime, modDatetime, timezone, heroImage } = data;
const readingTime = calculateReadingTime(body ?? "");
const related = getRelated(getPath(id, filePath));
const linkClass = "text-accent decoration-dashed underline-offset-4 hover:underline";
const alsoSources = related.flatMap((r) => (r.source ? [r.source] : [])).join(" ");

const headerProps = {
  style: { viewTransitionName: slugifyStr(title) },
  class: "text-lg font-medium decoration-dashed hover:underline",
};
---

<li class="my-8" data-source={source} data-also={alsoSources || undefined}>
  <div>
    <a
      href={getPath(id, filePath)}
      class="inline-block text-lg font-medium text-accent decoration-dashed underline-offset-4 focus-visible:no-underline focus-visible:underline-offset-0"
    >
      {
        variant === "h2" ? (
          <h2 {...headerProps}>{title}</h2>
        ) : (
          <h3 {...headerProps}>{title}</h3>
        )
      }
    </a>
    <div class="flex items-center gap-3 mb-3">
      <Datetime {pubDatetime} {modDatetime} {timezone} />
      <span class="text-sm italic opacity-80">{readingTime}</span>
    </div>
    <div class="flex gap-4 items-start">
      {showImage && heroImage && (
        <a 
          href={getPath(id, filePath)}
          class="flex-shrink-0 hidden sm:block group"
        >
          <Image
            src={heroImage}
            alt={title}
            width={140}
            height={79}
            class="rounded shadow-sm transition-[transform,box-shadow] duration-200 ease-out group-hover:shadow-md group-hover:scale-105 motion-reduce:transition-none motion-reduce:group-hover:scale-100 object-cover"
            format="webp"
            quality={80}
            loading="lazy"
            densities={[1, 2]}
          />
        </a>
      )}
      <p class="opacity-80 flex-1">{description}</p>
    </div>
    {related.length > 0 && (
      <ul class="mt-3 grid grid-cols-[max-content_minmax(0,1fr)] gap-x-4 gap-y-1 border-l border-dashed border-accent/60 pl-4 text-sm">
        {related.map((r) => (
          <li class="contents">
            <span class="flex items-center gap-1.5 opacity-70">
              {r.icon && <img src={r.icon} alt="" width="14" height="14" class="rounded-[3px]" />}
              {r.label}
            </span>
            <span class="text-pretty">
              <a href={r.href} target="_blank" rel="noopener noreferrer" class={linkClass}>{r.title}</a>{r.recording && <>, <a href={r.recording} target="_blank" rel="noopener noreferrer" class={linkClass}>recording</a></>}
            </span>
          </li>
        ))}
      </ul>
    )}
  </div>
</li>
