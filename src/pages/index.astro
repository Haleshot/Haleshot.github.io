---
import { getCollection } from "astro:content";
import dayjs from "dayjs";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import IconRss from "@/assets/icons/IconRss.svg";
import Card from "@/components/Card.astro";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import Hr from "@/components/Hr.astro";
import LinkButton from "@/components/LinkButton.astro";
import RelatedMark from "@/components/RelatedMark.astro";
import Socials from "@/components/Socials.astro";
import StructuredData from "@/components/StructuredData.astro";
import { SITE, SOCIALS } from "@/config";
import { BYLINES, bylineSource, outletIcon } from "@/data/bylines";
import { TALKS } from "@/data/talks";
import Layout from "@/layouts/Layout.astro";
import { getPath } from "@/utils/getPath";
import { getRelated } from "@/utils/getRelated";
import getSortedPosts from "@/utils/getSortedPosts";
import { isRecap } from "@/utils/postKind";

const posts = await getCollection("blog");

const sortedPosts = getSortedPosts(posts);
const posts2025AndLater = sortedPosts.filter(({ data }) => data.pubDatetime.getFullYear() >= 2025);
const featuredPosts = posts2025AndLater.filter(({ data }) => data.featured);
const recentPosts = posts2025AndLater.filter(({ data }) => !data.featured);
const recentRecaps = recentPosts.filter(isRecap).slice(0, SITE.postPerIndex);
const recentOther = recentPosts.filter((post) => !isRecap(post)).slice(0, SITE.postPerIndex);

// One row per outlet, newest pieces first, linking to that outlet's view of /posts
const outlets = [...new Set(BYLINES.map(bylineSource))]
  .map((key) => {
    const all = BYLINES.filter((b) => bylineSource(b) === key);
    const dated = all
      .filter((b) => b.pubDate)
      .sort((a, b) => (b.pubDate as string).localeCompare(a.pubDate as string));
    return {
      key,
      label: all[0].outlet.replace(/ blog$/, ""),
      icon: outletIcon(all[0]),
      count: all.length,
      latest: (dated.length > 0 ? dated : all).slice(0, 2),
    };
  })
  .sort((a, b) => b.count - a.count);
---

<Layout description="Srihari Thyagarajan: Technical Writer at Deepnote. Writing about developer tools, documentation, and technical content, especially notebooks and open-source communities.">
  <StructuredData type="WebSite" data={{}} />
  <StructuredData type="Person" data={{}} />
  <Header />
  <main id="main-content" data-layout="index">
    <section id="hero" class="pt-6 pb-4">
      <div class="flex flex-col sm:flex-row items-start gap-4">
        <a href="/about" class="block mx-auto sm:mx-0 group">
          <img 
            src="/srihari-avatar.png" 
            alt="Srihari Thyagarajan" 
            class="w-40 h-40 rounded-full object-cover flex-shrink-0 transition-transform duration-200 ease-out group-hover:scale-[1.03] motion-reduce:transition-none motion-reduce:group-hover:scale-100"
          />
        </a>
        <div class="flex-1 text-center sm:text-left">
          <div class="flex items-center gap-2 justify-center sm:justify-start">
            <h1 class="my-2 inline-block text-2xl font-bold sm:my-4 sm:text-3xl">
              Hi, I'm Srihari.
            </h1>
            <a
              target="_blank"
              href="/rss.xml"
              class="inline-block"
              aria-label="rss feed"
              title="RSS Feed"
            >
              <IconRss
                width={20}
                height={20}
                class="scale-125 stroke-accent stroke-3"
              />
              <span class="sr-only">RSS Feed</span>
            </a>
          </div>
          <p>
            Technical Writer at <a href="https://deepnote.com/" target="_blank" rel="noopener noreferrer" class="text-accent underline underline-offset-2 hover:text-accent-dark focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent transition-colors duration-200">Deepnote</a>. Prev at <a href="https://marimo.io/" target="_blank" rel="noopener noreferrer" class="text-accent underline underline-offset-2 hover:text-accent-dark focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent transition-colors duration-200">marimo</a>. Co-organizer at <a href="https://github.com/scipy-india/" target="_blank" rel="noopener noreferrer" class="text-accent underline underline-offset-2 hover:text-accent-dark focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent transition-colors duration-200">SciPy India</a> and <a href="https://write-the-docs-india.github.io/" target="_blank" rel="noopener noreferrer" class="text-accent underline underline-offset-2 hover:text-accent-dark focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent transition-colors duration-200">Write the Docs India</a>.<br />
            I write about developer tools, documentation, and technical content, especially notebooks and open-source communities.
          </p>
          {
            // only display if at least one social link is enabled
            SOCIALS.filter((social) => social.active).length > 0 && (
              <div class="mt-4 flex flex-row items-center justify-center sm:justify-start">
                <Socials />
              </div>
            )
          }
        </div>
      </div>
    </section>

    {
      featuredPosts.length > 0 && (
        <>
          <section id="featured" class="pt-12 pb-6">
            <h2 class="text-2xl font-semibold tracking-wide">Featured</h2>
            <ul>
              {featuredPosts.map((data) => (
                <Card variant="h3" {...data} showImage={false} />
              ))}
            </ul>
          </section>
          {recentPosts.length > 0 && <Hr />}
        </>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold">Event recaps</h2>
          <ul class="mt-4">
            {recentRecaps.map((post) => (
              <li class="grid grid-cols-[6rem_minmax(0,1fr)] items-baseline gap-x-4 py-2">
                <span class="text-sm tabular-nums opacity-70">{dayjs(post.data.pubDatetime).format("MMM YYYY")}</span>
                <div>
                  <a
                    href={getPath(post.id, post.filePath)}
                    class="font-medium text-accent text-pretty decoration-dashed underline-offset-4 hover:underline"
                  >
                    {post.data.title}
                  </a>
                  {getRelated(getPath(post.id, post.filePath)).map((r) => (
                    <div class="text-sm">
                      <RelatedMark icon={r.icon} size={14} class="mr-1.5 inline-block align-[-2px]" />
                      <span class="sr-only">{r.kind === "talk" ? "Talk: " : `On ${r.label}: `}</span>
                      <a
                        href={r.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-accent decoration-dashed underline-offset-4 hover:underline"
                      >
                        {r.title}
                      </a>
                    </div>
                  ))}
                </div>
              </li>
            ))}
          </ul>
          {recentOther.length > 0 && (
            <>
              <h3 class="mt-8 text-xl font-semibold">More posts</h3>
              <ul class="mt-4">
                {recentOther.map((data) => (
                  <Card variant="h3" {...data} showImage={false} />
                ))}
              </ul>
            </>
          )}
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href="/posts/">
        All Posts
        <IconArrowRight class="inline-block" />
      </LinkButton>
    </div>

    {
      BYLINES.length > 0 && (
        <>
          <Hr />
          <section id="writing-elsewhere" class="pt-12 pb-6">
            <h2 class="text-2xl font-semibold">Writing elsewhere</h2>
            <ul class="mt-4">
              {outlets.map((o) => (
                <li class="grid gap-x-4 py-3 sm:grid-cols-[12.5rem_minmax(0,1fr)] sm:items-baseline">
                  <a
                    href={`/posts/?from=${o.key}`}
                    class="flex items-center gap-2 self-start text-sm decoration-dashed underline-offset-4 opacity-80 hover:text-accent hover:underline hover:opacity-100"
                  >
                    {o.icon && <img src={o.icon} alt="" width="16" height="16" class="rounded-[3px]" />}
                    {o.label}
                    <span class="sr-only">, everything I've written there</span>
                  </a>
                  <div>
                    {o.latest.map((byline) => (
                      <div class="py-0.5">
                        <a
                          href={byline.href}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="font-medium text-accent text-pretty decoration-dashed underline-offset-4 hover:underline"
                        >
                          {byline.title}
                        </a>
                      </div>
                    ))}
                  </div>
                </li>
              ))}
            </ul>
          </section>
        </>
      )
    }

    {
      TALKS.length > 0 && (
        <>
          <Hr />
          <section id="talks" class="pt-12 pb-6">
            <div class="flex items-baseline justify-between">
              <h2 class="text-2xl font-semibold">Talks</h2>
              <a href="/talks" class="text-sm text-accent underline decoration-dashed underline-offset-4 hover:text-accent-dark">All talks</a>
            </div>
            <ul class="mt-4">
              {TALKS.slice(0, 4).map((talk) => (
                <li class="grid grid-cols-[6rem_minmax(0,1fr)] items-baseline gap-x-4 py-2">
                  <span class="text-sm tabular-nums opacity-70">{talk.date.replace(/^(\w{3})\w*/, "$1")}</span>
                  <div>
                    <a
                      href={talk.slides ?? talk.post}
                      target={talk.slides ? "_blank" : undefined}
                      rel={talk.slides ? "noopener noreferrer" : undefined}
                      class="font-medium text-accent text-pretty decoration-dashed underline-offset-4 hover:underline"
                    >
                      {talk.title}
                    </a>
                    <div class="text-sm">
                      <span class="opacity-70">{talk.venue}</span>
                      {talk.recording && (
                        <>
                          {" "}
                          <a
                            href={talk.recording}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="text-accent decoration-dashed underline-offset-4 hover:underline"
                          >
                            recording
                          </a>
                        </>
                      )}
                    </div>
                  </div>
                </li>
              ))}
            </ul>
          </section>
        </>
      )
    }
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>
