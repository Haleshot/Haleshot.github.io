---
import { type CollectionEntry, getCollection } from "astro:content";
import BylineLedger from "@/components/BylineLedger.astro";
import Card from "@/components/Card.astro";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import { SITE } from "@/consts";
import { BYLINES, type Byline, bylineSource, outletIcon } from "@/data/bylines";
import Layout from "@/layouts/Layout.astro";
import getPostsByGroupCondition from "@/utils/getPostsByGroupCondition";
import { isRecap } from "@/utils/postKind";

const posts = await getCollection("blog", ({ data }) => !data.draft);

// Own posts and writing elsewhere share one timeline. A byline with `related`
// shows under that post's card instead of on its own.
type Entry = { date: Date; post: CollectionEntry<"blog"> } | { date: Date; byline: Byline };
const entries: Entry[] = [
  ...posts.map((post) => ({ date: new Date(post.data.pubDatetime || new Date()), post })),
  ...BYLINES.filter((b) => b.pubDate && !b.related).map((byline) => ({
    // Noon, so a date-only string lands on the same day in any build timezone
    date: new Date(`${byline.pubDate}T12:00:00`),
    byline,
  })),
];
const series = BYLINES.filter((b) => !b.pubDate);

const newestFirst = (a: Entry, b: Entry) => b.date.getTime() - a.date.getTime();

const kindOf = (post: CollectionEntry<"blog">) => (isRecap(post) ? "recaps" : "other");

// The filter doubles as the key for the outlet marks further down: one row for
// what's here, one for where else I write. Each row's label filters the whole row.
const outlets = [...new Set(BYLINES.map(bylineSource))]
  .map((key) => {
    const matches = BYLINES.filter((b) => bylineSource(b) === key);
    return {
      key,
      label: matches[0].outlet.replace(/ blog$/, ""),
      count: matches.length,
      icon: outletIcon(matches[0]),
    };
  })
  .sort((a, b) => b.count - a.count);
const filterRows = [
  {
    head: { key: "here", label: "On this site", count: posts.length },
    items: [
      { key: "recaps", label: "Recaps", count: posts.filter(isRecap).length, icon: undefined },
      {
        key: "other",
        label: "Other posts",
        count: posts.filter((p) => !isRecap(p)).length,
        icon: undefined,
      },
    ],
  },
  { head: { key: "elsewhere", label: "Elsewhere", count: BYLINES.length }, items: outlets },
];
const filterClass =
  "inline-flex min-h-11 items-center gap-2 decoration-dashed underline-offset-4 transition-colors duration-150 ease-out hover:text-accent aria-pressed:text-accent aria-pressed:underline focus-visible:outline-2 focus-visible:outline-dashed focus-visible:outline-offset-2 focus-visible:outline-accent motion-reduce:transition-none";

const months = [
  "January",
  "February",
  "March",
  "April",
  "May",
  "June",
  "July",
  "August",
  "September",
  "October",
  "November",
  "December",
];
---

<Layout title={`Posts | ${SITE.title}`} description="Archive of all blog posts by Srihari Thyagarajan. iOS, Swift, web development, and open source insights.">
  <Header />
  <main id="main-content" class="mx-auto w-full max-w-3xl px-4 pb-4">
    <h1 class="text-2xl font-semibold sm:text-3xl mt-8">All Posts</h1>
    <p class="mt-2 mb-6 italic">Browse all blog posts by year and month</p>
    <div role="group" aria-label="Filter posts" class="mb-8 grid grid-cols-[auto_minmax(0,1fr)] gap-x-6 text-sm" data-post-filters hidden>
      {filterRows.map((row) => (
        <>
          <button type="button" data-filter={row.head.key} aria-pressed="false" class:list={[filterClass, "font-medium"]}>
            {row.head.label}
            <span class="tabular-nums opacity-60">{row.head.count}</span>
          </button>
          <div class="flex flex-wrap gap-x-5">
            {row.items.map((f) => (
              <button type="button" data-filter={f.key} aria-pressed="false" class={filterClass}>
                {f.icon && <img src={f.icon} alt="" width="16" height="16" class="rounded-[3px]" />}
                {f.label}
                <span class="tabular-nums opacity-60">{f.count}</span>
              </button>
            ))}
          </div>
        </>
      ))}
    </div>
    {
      Object.entries(
        getPostsByGroupCondition(entries, (entry) => entry.date.getFullYear()),
      )
        .sort(([yearA], [yearB]) => Number(yearB) - Number(yearA))
        .map(([year, yearGroup]) => (
          <div class="mb-8" data-group>
            <h2 class="text-2xl font-bold mb-6 border-b border-accent pb-2">
              {year}
              <sup class="text-sm ml-1" data-count>{yearGroup.length}</sup>
            </h2>
            {Object.entries(
              getPostsByGroupCondition(yearGroup, (entry) => entry.date.getMonth() + 1),
            )
              .sort(([monthA], [monthB]) => Number(monthB) - Number(monthA))
              .map(([month, monthGroup]) => (
                <div class="mt-8" data-group>
                  <h3 class="text-xl font-bold mb-4">
                    {months[Number(month) - 1]}
                    <sup class="text-sm ml-1" data-count>{monthGroup.length}</sup>
                  </h3>
                  <ul>
                    {monthGroup
                      .sort(newestFirst)
                      .flatMap((entry) => ("post" in entry ? [<Card {...entry.post} source={kindOf(entry.post)} />] : []))}
                    {monthGroup.some((entry) => "byline" in entry) && (
                      <BylineLedger
                        bylines={monthGroup.sort(newestFirst).flatMap((entry) => ("byline" in entry ? [entry.byline] : []))}
                      />
                    )}
                  </ul>
                </div>
              ))}
          </div>
        ))
    }
    {
      series.length > 0 && (
        <div class="mb-8" data-group>
          <h2 class="text-2xl font-bold mb-6 border-b border-accent pb-2">Ongoing elsewhere</h2>
          <ul>
            <BylineLedger bylines={series} />
          </ul>
        </div>
      )
    }
  </main>
  <Footer />
</Layout>

<style>
  @keyframes post-in {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
  }
  :global([data-source].post-in) {
    animation: post-in 180ms ease-out;
  }
  @media (prefers-reduced-motion: reduce) {
    :global([data-source].post-in) {
      animation: none;
    }
  }
</style>

<script>
  function setupPostFilters() {
    const bar = document.querySelector<HTMLElement>("[data-post-filters]");
    if (!bar) return;
    bar.hidden = false;
    const buttons = [...bar.querySelectorAll<HTMLButtonElement>("[data-filter]")];
    const items = [...document.querySelectorAll<HTMLElement>("main [data-source]")];
    const groups = [...document.querySelectorAll<HTMLElement>("main [data-group]")];

    const here = new Set(["recaps", "other"]);
    const matches = (item: HTMLElement, key: string) => {
      const source = item.dataset.source ?? "";
      const also = (item.dataset.also ?? "").split(" ").filter(Boolean);
      if (key === "all") return true;
      if (key === "here") return here.has(source);
      if (key === "elsewhere") return !here.has(source) || also.length > 0;
      return source === key || also.includes(key);
    };

    const apply = (key: string, animate: boolean) => {
      for (const b of buttons) b.setAttribute("aria-pressed", String(b.dataset.filter === key));
      for (const item of items) {
        const show = matches(item, key);
        if (show && item.hidden && animate) {
          item.classList.remove("post-in");
          void item.offsetWidth;
          item.classList.add("post-in");
        }
        item.hidden = !show;
      }
      for (const group of groups) {
        const visible = group.querySelectorAll("[data-source]:not([hidden])").length;
        group.hidden = visible === 0;
        const count = group.querySelector("[data-count]");
        if (count) count.textContent = String(visible);
      }
    };

    const url = new URL(location.href);
    const initial = url.searchParams.get("from");
    if (initial && buttons.some((b) => b.dataset.filter === initial)) apply(initial, false);

    for (const b of buttons) {
      b.addEventListener("click", () => {
        // Pressing the active filter again goes back to everything
        const key = b.getAttribute("aria-pressed") === "true" ? "all" : (b.dataset.filter ?? "all");
        apply(key, true);
        if (key === "all") url.searchParams.delete("from");
        else url.searchParams.set("from", key);
        history.replaceState(history.state, "", url);
      });
    }
  }

  document.addEventListener("astro:page-load", setupPostFilters);
</script>
